SELECT P.NUMORIGINAL
  FROM PCPRODUT P, PCTABPR PR, PCEST E
 WHERE P.CODPROD = PR.CODPROD
   AND P.CODPROD = E.CODPROD
   AND E.CODFILIAL = 1
   AND PR.NUMREGIAO = 1
   AND P.DTEXCLUSAO IS NULL
   AND P.MARCA NOT LIKE '%VMP%'
   AND P.NUMORIGINAL NOT LIKE '%VMP%'
   AND P.NUMORIGINAL NOT LIKE '%0X0001%'
 GROUP BY P.NUMORIGINAL
