	$pdf->SetFont('arial','',8);
	$pdf->Cell(15, $alturaLinha, $PDF['CABECALHO']['UF']  		, 0, 1);

	

// 	/*#####################################################################################################*/
	$pdf->SetFont('arial','b',8);
	$pdf->Cell(15, $alturaLinha, "RCA:" 					, 0, 0);
