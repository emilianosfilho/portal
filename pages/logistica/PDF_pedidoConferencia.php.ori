	$pdf->Cell(10, $alturaLinha, "CNPJ:" 						, 0, 0);
	$pdf->SetFont('arial','',8);
	$pdf->Cell(52, $alturaLinha, $PDF['CABECALHO']['CNPJ']  		, 0, 0);
